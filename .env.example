# ──────────────────────────────────────────────────────
# CodeSync AI — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=4000
YJS_PORT=1234

# ─── Database (PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://codesync:codesync_pass@localhost:5432/codesync_db

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ─────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_in_production
JWT_REFRESH_SECRET=change_this_to_another_random_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ─── OpenAI API ─────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─── Client ─────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:1234
